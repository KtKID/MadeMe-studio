# 仅用于回环地址的隔离本地开发；复制为 .dev.vars，不要提交真实配置。
ENVIRONMENT=development
ALLOW_LOCAL_DEV_IDENTITY=true
DEV_OWNER_ID=local-test-owner
OWNER_ID=local-test-owner

# 生产 Sites 使用 AUTH_MODE=sites，删除上述开发身份开关，并安全配置实际作者。
# OWNER_ID 优先；仅在没有 OWNER_ID 时使用可信 OWNER_EMAIL。
# AUTH_MODE=sites
# OWNER_EMAIL=

# 以下仅列配置名称，不含可用凭据。未配置时相应能力明确不可用。
# SESSION_SECRET=
# OPENAI_API_KEY=
# IMAGE_API_KEY=
# IMAGE_MODEL=
# OPENROUTER_API_KEY=
# SILICONFLOW_API_KEY=
# SILICONFLOW_IMAGE_HOSTS=
# GEMINI_API_KEY=
# CLOUDFLARE_AI_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# 独立密码模式仅在确定部署环境并安全配置后启用；不要与本地开发身份混用。
# AUTH_MODE=password
# AUTH_PASSWORD_HASH=

# Google 单作者登录：仅配置名称；真实值通过部署 Secrets / 变量安全设置。
# 不与开发身份混用；未经真实 OAuth 与越权验收不能宣布生产登录可用。
# AUTH_MODE=google
# APP_ORIGIN=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OWNER_EMAIL=
# OWNER_GOOGLE_SUB=
# SESSION_SECRET=

# 日志级别：debug / info / warn / error，默认 info（低于该级别的日志不输出；拼写错误会记一条 log.invalid_level 并回退 info）。
# LOG_LEVEL=info

# 本地开发端口不在这里设置：它是命令行环境变量，例如 `DEV_PORT=5000 npm run dev`。
# 唯一来源见 scripts/dev-config.mjs（默认 4321，只监听 127.0.0.1）。
