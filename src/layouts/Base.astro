---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import { accentOverrideStyle } from "../components/shared/appearance";
interface Props {
  clientNavigation?: boolean;
  title?: string;
  description?: string;
  theme?: string;
  mode?: string;
  skin?: string;
  font?: string;
  accent?: string | null;
}
const {
  clientNavigation = false,
  title = "MadeMe · 写作与发布",
  description = "一个安静的地方，写下值得分享的事。",
  theme = "paper",
  mode = "system",
  skin = "amber",
  font = "yahei",
  accent,
} = Astro.props;
const accentStyle = accentOverrideStyle(accent);
---

<!doctype html>
<html
  style={accentStyle}
  lang="zh-CN"
  data-theme={theme}
  data-mode={mode}
  data-skin={skin}
  data-font={font}
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, interactive-widget=resizes-content"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f3" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {clientNavigation && <ClientRouter fallback="swap" />}
    <script is:inline data-astro-rerun>
      // 首屏与系统模式保持一致；不保存身份或敏感信息。
      (() => {
        window.__mademeModeCleanup?.();
        const root = document.documentElement;
        const preference = window.matchMedia("(prefers-color-scheme: dark)");
        const applyMode = () => {
          root.dataset.colorMode =
            root.dataset.mode === "system"
              ? preference.matches
                ? "dark"
                : "light"
              : root.dataset.mode;
        };
        applyMode();
        preference.addEventListener("change", applyMode);
        const observer = new MutationObserver(applyMode);
        observer.observe(root, {
          attributes: true,
          attributeFilter: ["data-mode"],
        });
        window.__mademeModeCleanup = () => {
          preference.removeEventListener("change", applyMode);
          observer.disconnect();
        };
      })();
    </script>
    <script is:inline>
      // 展示衍生（/api/images/...）失败时回退到落库图本身（data-fallback-src，即 /api/files/:id）。
      // 捕获阶段监听整个文档：图片 error 事件不冒泡，React/Astro 渲染的图片都能覆盖；只回退一次。
      // 不加 data-astro-rerun：监听挂在 document 上，客户端路由切页后仍然有效，避免重复注册。
      if (!window.__mademeImageFallback) {
        window.__mademeImageFallback = true;
        document.addEventListener(
          "error",
          (event) => {
            const image = event.target;
            if (!(image instanceof HTMLImageElement)) return;
            const fallback = image.dataset.fallbackSrc;
            if (!fallback || image.dataset.fallbackUsed) return;
            image.dataset.fallbackUsed = "1";
            image.removeAttribute("srcset");
            image.removeAttribute("sizes");
            image.src = fallback;
            console.warn("[mademe]", {
              event: "image.derivative_fallback",
              src: fallback,
            });
          },
          true,
        );
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳到主要内容
    </a>
    <slot />
  </body>
</html>
