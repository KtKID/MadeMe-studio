---
import Studio from "../../layouts/Studio.astro";
import Integrations from "../../components/integrations/Integrations";
import { loadIntegrationsPageData } from "../../server/page-data";
const data = await loadIntegrationsPageData(Astro);
---

<Studio title="连接与发布" active="integrations" settings={data.settings}>
  <Integrations
    initialTokens={data.initialTokens}
    initialError={data.initialError}
    authenticated={data.capabilities.authenticated}
    client:load
  />
</Studio>
