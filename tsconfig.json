{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "**/dist/**",
    "**/node_modules/**",
    "integrations/obsidian-publisher",
    "worker-dist",
    ".astro",
    ".wrangler",
    ".schema-gen",
    ".schema-baseline"
  ]
}
