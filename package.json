{
  "name": "mademe-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev --host 127.0.0.1",
    "build": "node scripts/run-astro.mjs build && node scripts/package-worker.mjs",
    "check": "node scripts/run-astro.mjs check",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "test:smoke": "node scripts/smoke-local.mjs",
    "test:e2e": "playwright test",
    "test:worker": "node scripts/test-worker.mjs",
    "test:integrations": "node --test integrations/tests/*.node.mjs",
    "format": "prettier --write src tests scripts docs *.ts *.mjs"
  },
  "dependencies": {
    "astro": "7.4.2",
    "@astrojs/cloudflare": "14.4.2",
    "@astrojs/react": "7.1.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "@blocknote/core": "0.56.0",
    "@blocknote/react": "0.56.0",
    "@blocknote/mantine": "0.56.0",
    "@mantine/core": "^8.3.0",
    "@mantine/hooks": "^8.3.0",
    "zod": "^4.0.0",
    "lucide-react": "^1.31.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24",
    "vitest": "^4.1.5",
    "drizzle-kit": "0.31.10",
    "wrangler": "^4.125.0",
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  },
  "overrides": {
    "undici@>=7.0.0 <7.30.1": "7.30.1"
  },
  "engines": {
    "node": ">=24"
  }
}
