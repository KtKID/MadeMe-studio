    "@mantine/hooks": "^8.3.0",
    "zod": "^4.0.0",
    "lucide-react": "^1.31.0",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@astrojs/check": "latest",
    "typescript": "^5.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/node": "^24",
    "vitest": "^4.1.5",
    "drizzle-kit": "0.31.10",
